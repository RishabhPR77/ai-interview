# ── Runtime ────────────────────────────────────────────────────────────────
# "production" refuses to start unless SECRET_KEY, ENCRYPTION_KEY, BREVO_API_KEY
# and EMAIL_FROM_ADDRESS are set. In development they're auto-generated / optional.
ENV=development
APP_URL=http://localhost:5173

# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Encrypts users' provider API keys at rest. Back it up — losing or changing it
# means every user has to re-enter their keys.
ENCRYPTION_KEY=

# SQLite by default (stored in DATA_DIR). Use Postgres in production:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_URL=
DATA_DIR=./data

# ── Email sign-in codes (Brevo) ────────────────────────────────────────────
# Without a key in development, codes are printed to the server console.
BREVO_API_KEY=
# Must be a sender/domain verified in your Brevo account.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=tejaskrit

# ── Bot protection on sign-in (Cloudflare Turnstile) ───────────────────────
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile and set
# both keys (or neither to disable). Test keys that always pass:
#   site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Usage limits ───────────────────────────────────────────────────────────
MAX_INTERVIEWS_PER_DAY=10
# Longest answer analysed, in seconds (the web app stops recording at 180s).
MAX_ANSWER_SECONDS=240
# Finished reports can be reopened for this long, then are deleted.
REPORT_RETENTION_HOURS=24
# Parallel answer analyses per server (each is CPU-heavy).
ANALYSIS_WORKERS=2

# ── Cookies / CORS ─────────────────────────────────────────────────────────
# Keep "lax" when the API also serves the web app (recommended). Use "none"
# (HTTPS only) if the frontend lives on a different site.
COOKIE_SAMESITE=lax
# Only needed when the frontend is on a different origin than the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Misc ───────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=100
# Offline Whisper fallback; requires requirements-local-whisper.txt
LOCAL_WHISPER_FALLBACK=false
