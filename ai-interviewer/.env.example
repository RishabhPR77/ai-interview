# ── Runtime ────────────────────────────────────────────────────────────────
# "production" refuses to start unless SECRET_KEY, ENCRYPTION_KEY, BREVO_API_KEY
# and EMAIL_FROM_ADDRESS are set. In development they're auto-generated / optional.
ENV=development
APP_URL=http://localhost:5173

# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Encrypts users' provider API keys at rest. Back it up — losing or changing it
# means every user has to re-enter their keys.
ENCRYPTION_KEY=

# SQLite by default (stored in DATA_DIR). Use Postgres in production:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_URL=
DATA_DIR=./data

# ── Email sign-in codes (Brevo) ────────────────────────────────────────────
# Without a key in development, codes are printed to the server console.
BREVO_API_KEY=
# Must be a sender/domain verified in your Brevo account.
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=tejaskrit

# ── Cookies / CORS ─────────────────────────────────────────────────────────
# Keep "lax" when the API also serves the web app (recommended). Use "none"
# (HTTPS only) if the frontend lives on a different site.
COOKIE_SAMESITE=lax
# Only needed when the frontend is on a different origin than the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Misc ───────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=200
# Offline Whisper fallback; requires requirements-local-whisper.txt
LOCAL_WHISPER_FALLBACK=false
