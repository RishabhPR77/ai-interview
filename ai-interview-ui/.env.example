# The dev server proxies /api to the backend (see vite.config.ts), so the app
# and API share an origin and the session cookie just works. Only set this if
# the API is hosted on a different origin (then also set COOKIE_SAMESITE=none
# and CORS_ORIGINS on the backend).
# VITE_API_URL=https://api.example.com/api/v1
